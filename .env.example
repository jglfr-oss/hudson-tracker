# Copy this to .env.local for local development.
# In production, set these in Vercel → Settings → Environment Variables.

DEXCOM_USERNAME=your_dexcom_username_here
DEXCOM_PASSWORD=your_dexcom_password_here

# Region: "us" (default) or "ous" (outside US)
DEXCOM_REGION=us

# ── T1D Pulse (news + social) — ALL OPTIONAL ────────────────────────────────
# The T1D Pulse tab works out of the box using free feeds (FDA/NIH/Google News/
# PubMed) and Bluesky's public API. The keys below add extra sources; leave any
# of them unset and that source is simply skipped (reported as "not_configured").
#
# Optional commercial news provider (free curated feeds are used without it):
# T1D_NEWS_API_KEY=your_news_api_key_here
#
# YouTube Data API v3 — enables the YouTube source:
# YOUTUBE_API_KEY=your_youtube_api_key_here
#
# X (Twitter) recent-search — enables the X source:
# X_BEARER_TOKEN=your_x_bearer_token_here
#
# Reddit official OAuth API — all three enable the Reddit source:
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
# REDDIT_USER_AGENT=hudson-tracker/1.0 by your_reddit_username
